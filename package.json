{
  "name": "sghss-api",
  "version": "0.1.0",
  "description": "API REST do Sistema de Gestão Hospitalar e de Serviços de Saúde (SGHSS) da VidaPlus",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:prepare": "test -f .env.test || (echo \"Crie o .env.test a partir do .env.test.example\" && exit 1) && bun --env-file=.env.test run db:deploy",
    "test": "bun test",
    "docs:diagramas": "docker run --rm -v ./docs/diagramas:/data plantuml/plantuml:1.2026.10 -tpng -charset UTF-8 '/data/*.puml'"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.4.4",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  }
}
