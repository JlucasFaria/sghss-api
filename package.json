{
  "name": "sghss-api",
  "version": "0.1.0",
  "description": "API REST do Sistema de Gestão Hospitalar e de Serviços de Saúde (SGHSS) da VidaPlus",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.4.4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0"
  }
}
