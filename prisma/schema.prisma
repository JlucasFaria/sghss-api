// Modelo de dados do SGHSS (ver docs/modelagem.md e docs/diagramas/der.puml).
// Convenção: modelos e campos em camelCase no código, tabelas e colunas em snake_case no banco.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Acesso e cadastros ----------

enum Perfil {
  ADMIN
  MEDICO
  ENFERMEIRO
  TECNICO
  PACIENTE

  @@map("perfil")
}

enum TipoUnidade {
  HOSPITAL
  CLINICA
  LABORATORIO
  HOME_CARE

  @@map("tipo_unidade")
}

enum Conselho {
  CRM
  COREN

  @@map("conselho")
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  perfil       Perfil
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  paciente     Paciente?
  profissional Profissional?

  @@map("usuario")
}

model Unidade {
  id           String      @id @default(uuid()) @db.Uuid
  nome         String      @db.VarChar(150)
  tipo         TipoUnidade
  endereco     String      @db.VarChar(255)
  cidade       String      @db.VarChar(100)
  uf           String      @db.Char(2)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  profissionais Profissional[]

  @@map("unidade")
}

// Campos "Cifrado" são gravados com AES-256-GCM; cpfHash (HMAC-SHA-256)
// garante a unicidade e permite buscar pelo CPF sem decifrar a tabela.
model Paciente {
  id              String    @id @default(uuid()) @db.Uuid
  usuarioId       String    @unique @map("usuario_id") @db.Uuid
  nome            String    @db.VarChar(150)
  cpfCifrado      String    @map("cpf_cifrado")
  cpfHash         String    @unique @map("cpf_hash") @db.Char(64)
  dataNascimento  DateTime  @map("data_nascimento") @db.Date
  telefoneCifrado String?   @map("telefone_cifrado")
  anonimizadoEm   DateTime? @map("anonimizado_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("paciente")
}

model Profissional {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  unidadeId     String   @map("unidade_id") @db.Uuid
  nome          String   @db.VarChar(150)
  conselho      Conselho
  registro      String   @db.VarChar(20)
  especialidade String?  @db.VarChar(100)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  unidade Unidade @relation(fields: [unidadeId], references: [id])

  @@unique([conselho, registro])
  @@map("profissional")
}
