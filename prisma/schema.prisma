// Modelo de dados do SGHSS (ver docs/modelagem.md e docs/diagramas/der.puml).
// Convenção: modelos e campos em camelCase no código, tabelas e colunas em snake_case no banco.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Acesso e cadastros ----------

enum Perfil {
  ADMIN
  MEDICO
  ENFERMEIRO
  TECNICO
  PACIENTE

  @@map("perfil")
}

enum TipoUnidade {
  HOSPITAL
  CLINICA
  LABORATORIO
  HOME_CARE

  @@map("tipo_unidade")
}

enum Conselho {
  CRM
  COREN

  @@map("conselho")
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  perfil       Perfil
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  paciente     Paciente?
  profissional Profissional?

  @@map("usuario")
}

model Unidade {
  id           String      @id @default(uuid()) @db.Uuid
  nome         String      @db.VarChar(150)
  tipo         TipoUnidade
  endereco     String      @db.VarChar(255)
  cidade       String      @db.VarChar(100)
  uf           String      @db.Char(2)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  profissionais Profissional[]
  consultas     Consulta[]
  exames        Exame[]

  @@map("unidade")
}

// Campos "Cifrado" são gravados com AES-256-GCM; cpfHash (HMAC-SHA-256)
// garante a unicidade e permite buscar pelo CPF sem decifrar a tabela.
model Paciente {
  id              String    @id @default(uuid()) @db.Uuid
  usuarioId       String    @unique @map("usuario_id") @db.Uuid
  nome            String    @db.VarChar(150)
  cpfCifrado      String    @map("cpf_cifrado")
  cpfHash         String    @unique @map("cpf_hash") @db.Char(64)
  dataNascimento  DateTime  @map("data_nascimento") @db.Date
  telefoneCifrado String?   @map("telefone_cifrado")
  anonimizadoEm   DateTime? @map("anonimizado_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  consultas Consulta[]
  exames    Exame[]

  @@map("paciente")
}

model Profissional {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  unidadeId     String   @map("unidade_id") @db.Uuid
  nome          String   @db.VarChar(150)
  conselho      Conselho
  registro      String   @db.VarChar(20)
  especialidade String?  @db.VarChar(100)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  usuario   Usuario              @relation(fields: [usuarioId], references: [id])
  unidade   Unidade              @relation(fields: [unidadeId], references: [id])
  horarios  HorarioAgenda[]
  exames    Exame[]
  registros RegistroProntuario[]

  @@unique([conselho, registro])
  @@map("profissional")
}

// ---------- Agenda, consultas e exames ----------

enum StatusHorario {
  DISPONIVEL
  RESERVADO
  BLOQUEADO

  @@map("status_horario")
}

enum ModalidadeConsulta {
  PRESENCIAL
  TELEMEDICINA

  @@map("modalidade_consulta")
}

enum StatusConsulta {
  AGENDADA
  REALIZADA
  CANCELADA

  @@map("status_consulta")
}

enum StatusExame {
  AGENDADO
  REALIZADO
  CANCELADO

  @@map("status_exame")
}

// Sobreposição de horários e a regra fim > inicio são validadas no serviço.
model HorarioAgenda {
  id             String        @id @default(uuid()) @db.Uuid
  profissionalId String        @map("profissional_id") @db.Uuid
  inicio         DateTime
  fim            DateTime
  status         StatusHorario @default(DISPONIVEL)

  profissional Profissional @relation(fields: [profissionalId], references: [id])
  consultas    Consulta[]

  @@unique([profissionalId, inicio])
  @@map("horario_agenda")
}

// O profissional da consulta é obtido pelo horário; cancelar devolve o horário
// para DISPONIVEL, por isso um horário pode ter várias consultas no histórico.
model Consulta {
  id                 String             @id @default(uuid()) @db.Uuid
  pacienteId         String             @map("paciente_id") @db.Uuid
  horarioId          String             @map("horario_id") @db.Uuid
  unidadeId          String             @map("unidade_id") @db.Uuid
  modalidade         ModalidadeConsulta
  status             StatusConsulta     @default(AGENDADA)
  motivo             String?            @db.VarChar(500)
  motivoCancelamento String?            @map("motivo_cancelamento") @db.VarChar(500)
  criadoEm           DateTime           @default(now()) @map("criado_em")
  atualizadoEm       DateTime           @updatedAt @map("atualizado_em")

  paciente     Paciente             @relation(fields: [pacienteId], references: [id])
  horario      HorarioAgenda        @relation(fields: [horarioId], references: [id])
  unidade      Unidade              @relation(fields: [unidadeId], references: [id])
  teleconsulta Teleconsulta?
  registros    RegistroProntuario[]
  prescricoes  Prescricao[]

  @@map("consulta")
}

// O token de acesso à sala é gerado na entrada e não é armazenado.
model Teleconsulta {
  id          String    @id @default(uuid()) @db.Uuid
  consultaId  String    @unique @map("consulta_id") @db.Uuid
  provedor    String    @db.VarChar(50)
  salaId      String    @map("sala_id") @db.VarChar(255)
  urlSala     String    @map("url_sala") @db.VarChar(500)
  iniciadaEm  DateTime? @map("iniciada_em")
  encerradaEm DateTime? @map("encerrada_em")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  consulta Consulta @relation(fields: [consultaId], references: [id])

  @@map("teleconsulta")
}

model Exame {
  id               String      @id @default(uuid()) @db.Uuid
  pacienteId       String      @map("paciente_id") @db.Uuid
  unidadeId        String      @map("unidade_id") @db.Uuid
  responsavelId    String?     @map("responsavel_id") @db.Uuid
  tipo             String      @db.VarChar(150)
  dataHora         DateTime    @map("data_hora")
  status           StatusExame @default(AGENDADO)
  resultadoCifrado String?     @map("resultado_cifrado")
  resultadoEm      DateTime?   @map("resultado_em")
  criadoEm         DateTime    @default(now()) @map("criado_em")
  atualizadoEm     DateTime    @updatedAt @map("atualizado_em")

  paciente    Paciente      @relation(fields: [pacienteId], references: [id])
  unidade     Unidade       @relation(fields: [unidadeId], references: [id])
  responsavel Profissional? @relation(fields: [responsavelId], references: [id])

  @@map("exame")
}

// ---------- Prontuário e receitas ----------

// Somente inclusão: correções geram um novo registro, preservando o histórico.
// O autor pode ser outro profissional além do responsável pela consulta.
model RegistroProntuario {
  id              String   @id @default(uuid()) @db.Uuid
  consultaId      String   @map("consulta_id") @db.Uuid
  autorId         String   @map("autor_id") @db.Uuid
  conteudoCifrado String   @map("conteudo_cifrado")
  criadoEm        DateTime @default(now()) @map("criado_em")

  consulta Consulta     @relation(fields: [consultaId], references: [id])
  autor    Profissional @relation(fields: [autorId], references: [id])

  @@map("registro_prontuario")
}

// O banco guarda só o SHA-256 do código de verificação aleatório entregue na emissão.
model Prescricao {
  id                    String   @id @default(uuid()) @db.Uuid
  consultaId            String   @map("consulta_id") @db.Uuid
  codigoVerificacaoHash String   @unique @map("codigo_verificacao_hash") @db.Char(64)
  observacoes           String?  @db.VarChar(1000)
  emitidaEm             DateTime @default(now()) @map("emitida_em")
  validaAte             DateTime @map("valida_ate") @db.Date

  consulta Consulta         @relation(fields: [consultaId], references: [id])
  itens    ItemPrescricao[]

  @@map("prescricao")
}

model ItemPrescricao {
  id           String @id @default(uuid()) @db.Uuid
  prescricaoId String @map("prescricao_id") @db.Uuid
  medicamento  String @db.VarChar(150)
  dosagem      String @db.VarChar(100)
  posologia    String @db.VarChar(500)
  quantidade   Int

  prescricao Prescricao @relation(fields: [prescricaoId], references: [id], onDelete: Cascade)

  @@map("item_prescricao")
}
