# Banco de dados (docker compose)
POSTGRES_DB="sghss"
POSTGRES_USER="sghss"
# Evite @ : / # e ? na senha: ela entra na URL de conexão do compose (ou codifique-a para URL)
POSTGRES_PASSWORD="troque_esta_senha"
POSTGRES_PORT="5432"

# Prisma
DATABASE_URL="postgresql://sghss:troque_esta_senha@localhost:5432/sghss"

# Servidor
PORT="3000"
NODE_ENV="development"
# Origens permitidas no CORS, separadas por vírgula ("*" não é aceito em produção)
CORS_ORIGIN="http://localhost:5173"

# IPs dos proxies reversos confiáveis, separados por vírgula. Deixe vazio se a API for
# acessada diretamente. Só com o IP do proxy aqui o X-Forwarded-For é usado para
# identificar o cliente (auditoria e limites de requisições).
TRUST_PROXY=""

# Autenticação (JWT HS256). Gere um segredo com:
#   bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
JWT_SECRET="troque_por_um_segredo_aleatorio_de_32_caracteres_ou_mais"
# Validade do token em segundos
JWT_EXPIRES_IN="3600"

# Criptografia dos dados sensíveis: chaves de 32 bytes em base64, uma para cada uso.
# Os valores abaixo servem só para desenvolvimento: gere chaves novas (mesmo comando do
# JWT_SECRET) fora da máquina local. Perder a ENCRYPTION_KEY torna os dados ilegíveis.
ENCRYPTION_KEY="Y2hhdmUtYWVzLWRlc2Vudm9sdmltZW50by0zMi1ieXQ="
CPF_HASH_KEY="Y2hhdmUtaG1hYy1kZXNlbnZvbHZpbWVudG8tMzItYnk="

# Backup (bun run db:backup): pasta de destino e dias de retenção
BACKUP_DIR="backups"
BACKUP_RETENCAO_DIAS="7"
