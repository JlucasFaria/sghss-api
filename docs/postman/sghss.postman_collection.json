    {
      "name": "04 Agenda e consultas",
      "description": "Abertura de horários, agendamento, conflito e cancelamento.",
      "item": [
        {
          "name": "Médica abre horário daqui a 3 dias",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Horário curto (1 min) para não colidir com execuções anteriores da coleção",
                  "const inicio = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set(\"inicioFuturo\", inicio.toISOString());",
                  "pm.collectionVariables.set(\"fimFuturo\", new Date(inicio.getTime() + 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"horarioFuturoId\", pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/profissionais/{{profissionalId}}/horarios",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMedico}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inicio\": \"{{inicioFuturo}}\",\n  \"fim\": \"{{fimFuturo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "[Negativo] Horário sobreposto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
