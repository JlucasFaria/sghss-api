                  "pm.test(\"Erro no envelope padrão\", () => pm.expect(pm.response.json().error.code).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
