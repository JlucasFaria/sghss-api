    {
      "name": "05 Atendimento e receita",
      "description": "Consulta que começa em segundos: prontuário, conclusão, receita e validação pela farmácia.",
      "item": [
        {
          "name": "Médica abre horário que começa em 15 segundos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
