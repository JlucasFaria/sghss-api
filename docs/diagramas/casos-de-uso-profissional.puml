@startuml casos-de-uso-profissional
!include _estilo.iuml
title SGHSS VidaPlus — Casos de Uso dos Profissionais de Saúde

actor "Profissional de Saúde" as Profissional
actor "Médico" as Medico
actor "Enfermeiro / Técnico" as Enfermeiro
actor "Farmácia" as Farmacia <<sistema externo>>
actor "Provedor de Vídeo" as Provedor <<sistema externo>>

Medico --|> Profissional
Enfermeiro --|> Profissional

rectangle "SGHSS — API" {
  usecase "UC02 Autenticar-se" as UC02
  usecase "UC05 Gerenciar agenda" as UC05
  usecase "UC08 Consultar histórico clínico" as UC08
  usecase "UC11 Listar consultas" as UC11
  usecase "UC13 Registrar resultado de exame" as UC13
  usecase "UC14 Registrar evolução no prontuário" as UC14
  usecase "UC17 Realizar teleconsulta" as UC17
  usecase "UC15 Emitir receita digital" as UC15
  usecase "UC16 Validar receita" as UC16
}

Profissional -- UC02
Profissional -- UC05
Profissional -- UC08
Profissional -- UC11
Profissional -- UC13
Profissional -- UC14
Profissional -- UC17
Medico -- UC15

UC16 -- Farmacia
UC17 -- Provedor
@enduml
